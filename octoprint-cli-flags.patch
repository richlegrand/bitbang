From 16a5d0617d3ba3e4c86ae4ac3194e4e80b5093cd Mon Sep 17 00:00:00 2001
From: Rich LeGrand <rich@charmedlabs.com>
Date: Thu, 27 Aug 2026 16:03:19 -0500
Subject: [PATCH] cli: follow the flag changes on the bitbang-cli side

-forward-client-ip is now -proxy-client-ip. It stamps X-Forwarded-For on
proxied requests and always has; reading as a forwarding flag got worse once
forwarding became a capability over there.

-target is gone. `serve proxy <target>` was always the same thing, and the
flag turned out to be accepted-and-ignored on the combined mode, so it was
removed rather than narrowed. The target moves to a positional.

That reorder breaks the stale-process pkill, which matched the literal
"serve proxy -program octoprint" -- the two halves are no longer adjacent.
pkill -f takes a regex, so it bridges them now instead of matching a literal
that the next argv change would silently break again. Without this a Go proxy
orphaned by an OctoPrint restart survives and fights the new one for the
shared UID.

-video-fd comes out of the documented-flag list because it is hidden from
--help now. It is still passed and still parsed -- the full-argv test covers
it, which was the stronger of the two checks anyway.

The full-argv test needed rebuilding to be that stronger check. It appended
--help, which exits inside flag parsing, before the positional grammar runs
at all -- so it never saw the target, which is the one thing that moved.
`serve proxy frobnicate --help` exits 0. It now runs the real argv and reads
the exit code: 2 means the CLI rejected an argument, anything else means it
got past parsing. A second test feeds it a word no CLI could accept, so if
this ever stops exercising the grammar, something says so.

Needs a CLI built from a ref that has all of this.
---
 octoprint_bitbang/_plugin.py | 18 ++++++----
 tests/test_cli_contract.py   | 67 +++++++++++++++++++++++++++---------
 2 files changed, 62 insertions(+), 23 deletions(-)

diff --git a/octoprint_bitbang/_plugin.py b/octoprint_bitbang/_plugin.py
index 0c739b2..5f69802 100644
--- a/octoprint_bitbang/_plugin.py
+++ b/octoprint_bitbang/_plugin.py
@@ -299,8 +299,11 @@ class BitBangPlugin(
 
         # Stale Go proxies (orphaned by a prior OctoPrint restart) would
         # re-register our shared UID and conflict — kill them first. Match on
-        # args (path-independent); pkill never matches its own pid.
-        subprocess.run(["pkill", "-f", "serve proxy -program octoprint"], check=False)
+        # args (path-independent); pkill never matches its own pid. The target
+        # now sits between "proxy" and the flags, so the two halves are no
+        # longer adjacent -- pkill -f takes a regex, so bridge them rather than
+        # matching a literal that a later argv change can silently break.
+        subprocess.run(["pkill", "-f", "serve proxy .*-program octoprint"], check=False)
 
         self._go_stop = False
         threading.Thread(
@@ -334,17 +337,18 @@ class BitBangPlugin(
                 logf = open(log_path, "a", buffering=1)
             except Exception:
                 logf = subprocess.DEVNULL
-            # Go shares our identity (-program) → one URL; -target serves
-            # OctoPrint directly on the plain device URL.
-            args = [go_bin, "serve", "proxy", "-program", "octoprint",
-                    "-target", f"localhost:{port}", "-v", "-video-fd", str(child.fileno()),
+            # Go shares our identity (-program) → one URL; the positional
+            # target serves OctoPrint directly on the plain device URL.
+            args = [go_bin, "serve", "proxy", f"localhost:{port}",
+                    "-program", "octoprint",
+                    "-v", "-video-fd", str(child.fileno()),
                     # Always stamp the real browser IP as X-Forwarded-For — standard
                     # reverse-proxy behavior. Without it OctoPrint sees every request
                     # as coming from localhost, which (with autologinLocal) would
                     # auto-log-in a remote visitor. OctoPrint shows a one-time,
                     # per-browser "external access" notice as a result, which is
                     # accurate (the visitor IS external).
-                    "-forward-client-ip"]
+                    "-proxy-client-ip"]
             # The Go proxy owns the data channel + signaling, so it's what must
             # enforce the PIN — passing it to the Python adapter does nothing now.
             pin = (self._settings.get(["pin"]) or "").strip()
diff --git a/tests/test_cli_contract.py b/tests/test_cli_contract.py
index 0854ad0..4ba4f0e 100644
--- a/tests/test_cli_contract.py
+++ b/tests/test_cli_contract.py
@@ -13,19 +13,21 @@ works without a Go toolchain. CI builds bitbang-cli main and sets it.
 import os
 import re
 import subprocess
+import tempfile
 
 import pytest
 
 BIN = os.environ.get('BITBANG_BIN')
 pytestmark = pytest.mark.skipif(not BIN, reason='BITBANG_BIN not set')
 
-# Every flag _supervise_go passes. Keep in step with the argv there.
+# Every flag _supervise_go passes that is documented in --help. Keep in step
+# with the argv there. -video-fd is deliberately absent: it is internal
+# plumbing, hidden from help, and covered by the full-argv parse test below --
+# which is the stronger check anyway.
 PROXY_FLAGS = [
     '-program',
-    '-target',
     '-v',
-    '-video-fd',
-    '-forward-client-ip',
+    '-proxy-client-ip',
     '-pin',
 ]
 
@@ -51,16 +53,49 @@ def test_serve_proxy_still_accepts(flag):
 
 def test_the_full_argv_is_accepted():
     """Flags present in help is not the same as the combination parsing.
-    -help exits before serving, so this is a parse check, not a run."""
-    r = subprocess.run(
-        [BIN, 'serve', 'proxy',
+
+    And --help is not enough on its own: it exits inside flag parsing,
+    before the positional grammar is read at all, so `serve proxy
+    <target>` -- where the target now lives -- goes unchecked. `serve
+    proxy frobnicate --help` exits 0.
+
+    So run the real argv instead. The CLI exits 2 when it rejects an
+    argument, flag or positional, and something other than 2 once it is
+    past parsing and into starting up. -video-fd 3 pointed at /dev/null
+    is what makes that quick: the fd is not a socket, so it gets far
+    enough to prove the argv parsed and then stops on its own.
+    """
+    rc, out = _run_argv('localhost:5000')
+    assert rc != 2, f'the CLI rejected the argv the plugin builds:\n{out}'
+    assert 'is not something to serve' not in out, out
+
+
+def test_a_bogus_positional_is_still_caught():
+    """The guard on the guard. If the check above ever stops running the
+    grammar -- back to --help, say -- this is what notices, because a
+    word the CLI cannot possibly accept has to come back as a rejection.
+    """
+    rc, out = _run_argv('localhost:5000', 'frobnicate')
+    assert rc == 2, f'a bogus positional was accepted (rc={rc}):\n{out}'
+
+
+def _run_argv(*positionals):
+    """Run the plugin's argv with extra positionals, returning (rc, output).
+
+    A None rc means it was still running at the timeout, which counts as
+    accepted -- the CLI rejects argv long before it gets that far.
+    """
+    p = subprocess.Popen(
+        [BIN, 'serve', 'proxy', *positionals,
          '-program', 'octoprint',
-         '-target', 'localhost:5000',
-         '-v', '-video-fd', '3', '-forward-client-ip',
-         '-pin', '1234',
-         '-help'],
-        capture_output=True, text=True, timeout=30,
-    )
-    combined = r.stdout + r.stderr
-    for bad in ('flag provided but not defined', 'unknown subcommand'):
-        assert bad not in combined, f'{bad}:\n{combined}'
+         '-v', '-video-fd', '3', '-proxy-client-ip',
+         '-pin', '1234', '-ephemeral'],
+        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT, text=True,
+        pass_fds=(), env=dict(os.environ, HOME=tempfile.mkdtemp()))
+    try:
+        out = p.communicate(timeout=20)[0]
+        return p.returncode, out
+    except subprocess.TimeoutExpired:
+        p.kill()
+        return None, p.communicate()[0]
-- 
2.34.1

